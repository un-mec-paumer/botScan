generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  passwordHash  String?
  username      String?   @unique
  picture       Bytes?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime?
  deletedAt     DateTime?

  AuthToken     AuthToken[]
  mangaAlerts   MangaAlert[]
  animeAlerts   AnimeAlert[]

  @@map("users")
}

model AuthToken {
  id               String   @id @default(uuid())
  userId           String
  refreshToken     String   @unique
  refreshExpiresAt DateTime
  revoked          Boolean  @default(false)
  createdAt        DateTime @default(now())
  userAgent        String?
  ipAddress        String?

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_tokens")
}

model Manga {
  id           Int     @id @default(autoincrement())
  name         String
  synopsis     String?
  imgUrl       String?
  chapter      String?

  mangaSources MangaSource[]
  mangaAlerts  MangaAlert[]

  @@map("mangas")
}

model Anime {
  id           Int     @id @default(autoincrement())
  name         String
  synopsis     String?
  imgUrl       String?
  season       String?
  episode      String?

  animeSources AnimeSource[]
  animeAlerts  AnimeAlert[]

  @@map("animes")
}

model MangaAlert {
  userId  String
  mangaId Int

  User    User    @relation(fields: [userId], references: [id])
  Manga   Manga    @relation(fields: [mangaId], references: [id])

  @@id([userId, mangaId])
  @@map("manga_alerts")
}

model AnimeAlert {
  userId  String
  animeId Int

  User    User    @relation(fields: [userId], references: [id])
  Anime   Anime   @relation(fields: [animeId], references: [id])

  @@id([userId, animeId])
  @@map("anime_alerts")
}

model GlobalMangaSource {
  id           Int    @id @default(autoincrement())
  name         String
  domainUrl    String

  mangaSources MangaSource[]
  @@map("global_manga_sources")
}

model GlobalAnimeSource {
  id           Int    @id @default(autoincrement())
  name         String
  domainUrl    String

  animeSources AnimeSource[]
  @@map("global_anime_sources")
}

model MangaSource {
  link                String            @default("")
  globalMangaSourceId Int
  mangaId             Int

  GlobalMangaSource   GlobalMangaSource @relation(fields: [globalMangaSourceId], references: [id])
  Manga               Manga             @relation(fields: [mangaId], references: [id])

  @@id([globalMangaSourceId, mangaId])
  @@map("manga_sources")
}

model AnimeSource {
  link                String            @default("")
  globalAnimeSourceId Int
  animeId             Int

  GlobalAnimeSource   GlobalAnimeSource @relation(fields: [globalAnimeSourceId], references: [id])
  Anime               Anime             @relation(fields: [animeId], references: [id])

  @@id([globalAnimeSourceId, animeId])
  @@map("anime_sources")
}
